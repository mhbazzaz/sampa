{
  "name": "sampa-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_ENV=test jest",
    "production:test:e2e": "docker compose -f docker-compose.e2e.yml --env-file=.env.test.local run --build app",
    "production:test:e2e:after": "docker compose -f docker-compose.e2e.yml --env-file=.env.test.local down -v",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:before": "docker compose -f docker-compose.e2e.local.yml --env-file=.env.test.local up -d && nest build && cross-env NODE_ENV=test npx typeorm migration:run -d \"dist/config/typeorm-connection-source.js\" && cross-env NODE_ENV=test node ./dist/database/seeder/seeder.js",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json  --watch --runInBand",
    "test:e2e:after": "docker compose -f docker-compose.e2e.local.yml --env-file=.env.test.local down",
    "migration:generate": "nest build && cross-env NODE_ENV=development npx typeorm migration:generate \"src/database/migrations/%npm_config_name%\" -d \"dist/config/typeorm-connection-source.js\"",
    "test:migration:run": "cross-env NODE_ENV=test npx typeorm migration:run -d \"dist/config/typeorm-connection-source.js\"",
    "development:migration:run": "nest build && cross-env NODE_ENV=development npx typeorm migration:run -d \"dist/config/typeorm-connection-source.js\"",
    "production:migration:run": "nest build && cross-env NODE_ENV=production npx typeorm migration:run -d \"dist/config/typeorm-connection-source.js\"",
    "development:migration:revert": "nest build && cross-env NODE_ENV=development npx typeorm migration:revert -d \"dist/config/typeorm-connection-source.js\"",
    "production:migration:revert": "nest build && cross-env NODE_ENV=production npx typeorm migration:revert -d \"dist/config/typeorm-connection-source.js\"",
    "test:seed": "cross-env NODE_ENV=test node ./dist/database/seeder/seeder.js",
    "development:seed": "cross-env NODE_ENV=development node ./dist/database/seeder/seeder.js",
    "production:seed": "nest build && cross-env NODE_ENV=production node ./dist/database/seeder/seeder.js",
    "development:fake": "nest build && cross-env NODE_ENV=development node ./dist/database/faker/faker.js --name=%npm_config_name%",
    "production:fake": "nest build && cross-env NODE_ENV=production node ./dist/database/faker/faker.js --name=%npm_config_name%"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/multer": "^1.4.12",
    "@types/request-ip": "^0.0.41",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express-basic-auth": "^1.2.1",
    "magic-bytes.js": "^1.10.0",
    "moment-timezone": "^0.5.48",
    "multer": "1.4.5-lts.1",
    "nestjs-i18n": "10.5.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.0",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.0",
    "typeorm": "^0.3.20",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/qs": "^6.9.17",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.11.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.5.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
